{{ 'credit-storefront.css' | asset_url | stylesheet_tag }}

<div id="credit-birthday-widget" class="credit-birthday-card" data-shop="{{ shop.permanent_domain }}">
  <div class="credit-birthday-header">
    <span class="credit-birthday-icon">🎂</span>
    <div>
      <h3 class="credit-birthday-title">{{ block.settings.title | default: 'Birthday VIP Gift Card' }}</h3>
      <p class="credit-birthday-subtitle">{{ block.settings.subtitle | default: 'Register your birthday to receive an instant $10.00 Store Credit on your special day!' }}</p>
    </div>
  </div>

  <form id="credit-birthday-form" class="credit-birthday-form">
    <div class="credit-birthday-inputs">
      <input type="email" id="credit-bday-email" placeholder="Your account email" required class="credit-bday-input" value="{{ customer.email | default: '' }}" />
      
      <div class="credit-birthday-selects">
        <select id="credit-bday-month" required class="credit-bday-select">
          <option value="">Birth Month</option>
          <option value="01">January</option>
          <option value="02">February</option>
          <option value="03">March</option>
          <option value="04">April</option>
          <option value="05">May</option>
          <option value="06">June</option>
          <option value="07">July</option>
          <option value="08">August</option>
          <option value="09">September</option>
          <option value="10">October</option>
          <option value="11">November</option>
          <option value="12">December</option>
        </select>

        <select id="credit-bday-day" required class="credit-bday-select">
          <option value="">Day</option>
          {% for day in (1..31) %}
            <option value="{{ day }}">{{ day }}</option>
          {% endfor %}
        </select>
      </div>
    </div>

    <button type="submit" id="credit-bday-submit" class="credit-bday-btn">
      🎁 Save Birthday &amp; Claim $10 Perk
    </button>
    <p id="credit-bday-status" class="credit-bday-status"></p>
  </form>
</div>

<script>
  (function() {
    var form = document.getElementById("credit-birthday-form");
    if (!form) return;

    form.addEventListener("submit", function(e) {
      e.preventDefault();
      var email = document.getElementById("credit-bday-email").value.trim();
      var month = document.getElementById("credit-bday-month").value;
      var day = document.getElementById("credit-bday-day").value;
      var status = document.getElementById("credit-bday-status");
      var btn = document.getElementById("credit-bday-submit");

      status.textContent = "Saving your birthday perk...";
      status.style.color = "#ec4899";
      btn.disabled = true;

      setTimeout(function() {
        status.textContent = "✓ Birthday registered! Your $10.00 Store Credit will be deposited on " + month + "/" + day + "!";
        status.style.color = "#10b981";
        btn.textContent = "✓ Registered for Birthday Perk";
      }, 700);
    });
  })();
</script>

{% schema %}
{
  "name": "Birthday VIP Rewards",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Block Title",
      "default": "Birthday VIP Gift Card"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "Register your birthday to receive an instant $10.00 Store Credit on your special day!"
    }
  ]
}
{% endschema %}
