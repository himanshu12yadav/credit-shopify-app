{{ 'credit-storefront.css' | asset_url | stylesheet_tag }}

{% comment %}
  Digital Gift Card & Store Credit Gifting Block
  Allows shoppers to purchase or send store credit directly to friends/family.
{% endcomment %}

<div class="gift-credit-container" id="giftCreditWidget">
  <div class="gift-credit-card-preview-wrapper">
    <!-- Live Card Visualizer -->
    <div class="gift-card-visual" id="giftCardVisual" data-skin="emerald">
      <div class="gift-card-header">
        <span class="gift-card-brand">{{ shop.name | upcase }}</span>
        <span class="gift-card-badge">DIGITAL STORE CREDIT</span>
      </div>
      <div class="gift-card-chip">
        <div class="chip-line"></div>
        <div class="chip-line"></div>
      </div>
      <div class="gift-card-amount" id="previewAmount">$50.00</div>
      <div class="gift-card-footer">
        <div class="gift-card-recipient-info">
          <span class="gift-card-label">FOR</span>
          <span class="gift-card-name" id="previewRecipient">Valued Friend</span>
        </div>
        <div class="gift-card-logo">🎁</div>
      </div>
    </div>

    <!-- Skin / Theme Palette Selector -->
    <div class="gift-skin-picker">
      <span class="gift-picker-label">Card Style:</span>
      <div class="gift-skin-options">
        <button type="button" class="skin-circle skin-emerald active" data-skin="emerald" title="Emerald Luxury"></button>
        <button type="button" class="skin-circle skin-midnight" data-skin="midnight" title="Midnight Obsidian"></button>
        <button type="button" class="skin-circle skin-rose" data-skin="rose" title="Rose Gold Celebration"></button>
      </div>
    </div>
  </div>

  <!-- Interactive Gifting Form -->
  <div class="gift-form-wrapper">
    <h3 class="gift-form-title">Send Store Credit as a Gift</h3>
    <p class="gift-form-subtitle">Recipient receives an instant digital credit notification redeemable immediately at checkout.</p>

    <div class="gift-form-field">
      <label class="gift-label">Select Amount</label>
      <div class="gift-amount-pills">
        <button type="button" class="amount-pill" data-val="25">$25</button>
        <button type="button" class="amount-pill active" data-val="50">$50</button>
        <button type="button" class="amount-pill" data-val="100">$100</button>
        <button type="button" class="amount-pill" data-val="custom">Custom</button>
      </div>
      <div class="custom-amount-box" id="customAmountBox" style="display: none; margin-top: 8px;">
        <input type="number" id="customAmountInput" class="gift-input" placeholder="Enter amount (e.g. 75)" min="5" step="1">
      </div>
    </div>

    <div class="gift-grid-two">
      <div class="gift-form-field">
        <label class="gift-label" for="giftSenderName">Your Name</label>
        <input type="text" id="giftSenderName" class="gift-input" placeholder="e.g. Alex" value="{% if customer %}{{ customer.name }}{% endif %}">
      </div>
      <div class="gift-form-field">
        <label class="gift-label" for="giftRecipientName">Recipient Name</label>
        <input type="text" id="giftRecipientName" class="gift-input" placeholder="e.g. Sarah">
      </div>
    </div>

    <div class="gift-form-field">
      <label class="gift-label" for="giftRecipientEmail">Recipient Email Address *</label>
      <input type="email" id="giftRecipientEmail" class="gift-input" placeholder="friend@example.com" required>
    </div>

    <div class="gift-form-field">
      <label class="gift-label" for="giftMessage">Personal Note / Greeting</label>
      <textarea id="giftMessage" class="gift-textarea" rows="2" placeholder="Happy Birthday! Treat yourself to something special ✨"></textarea>
    </div>

    <button type="button" class="gift-submit-btn" id="sendGiftCardBtn">
      <span>🎁</span>
      <span id="submitBtnText">Send $50.00 Digital Gift Card</span>
    </button>

    <div id="giftStatusMessage" class="gift-status-msg" style="display: none;"></div>
  </div>
</div>

<script>
  (function() {
    let currentAmount = 50.0;
    let currentSkin = "emerald";

    const previewAmount = document.getElementById("previewAmount");
    const previewRecipient = document.getElementById("previewRecipient");
    const giftCardVisual = document.getElementById("giftCardVisual");
    const submitBtnText = document.getElementById("submitBtnText");
    const customAmountBox = document.getElementById("customAmountBox");
    const customAmountInput = document.getElementById("customAmountInput");
    const sendGiftCardBtn = document.getElementById("sendGiftCardBtn");
    const giftStatusMessage = document.getElementById("giftStatusMessage");

    // Skin Picker
    document.querySelectorAll(".skin-circle").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".skin-circle").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentSkin = btn.getAttribute("data-skin");
        giftCardVisual.setAttribute("data-skin", currentSkin);
      });
    });

    // Amount Pills
    document.querySelectorAll(".amount-pill").forEach(pill => {
      pill.addEventListener("click", () => {
        document.querySelectorAll(".amount-pill").forEach(p => p.classList.remove("active"));
        pill.classList.add("active");
        const val = pill.getAttribute("data-val");
        if (val === "custom") {
          customAmountBox.style.display = "block";
          currentAmount = parseFloat(customAmountInput.value) || 25.0;
        } else {
          customAmountBox.style.display = "none";
          currentAmount = parseFloat(val);
        }
        updateAmountDisplay();
      });
    });

    customAmountInput.addEventListener("input", (e) => {
      const val = parseFloat(e.target.value);
      if (!isNaN(val) && val > 0) {
        currentAmount = val;
        updateAmountDisplay();
      }
    });

    function updateAmountDisplay() {
      previewAmount.textContent = "$" + currentAmount.toFixed(2);
      submitBtnText.textContent = "Send $" + currentAmount.toFixed(2) + " Digital Gift Card";
    }

    // Recipient Name dynamic preview
    const recipientInput = document.getElementById("giftRecipientName");
    recipientInput.addEventListener("input", (e) => {
      previewRecipient.textContent = e.target.value.trim() || "Valued Friend";
    });

    // Submit handler
    sendGiftCardBtn.addEventListener("click", async () => {
      const recipientEmail = document.getElementById("giftRecipientEmail").value.trim();
      const senderName = document.getElementById("giftSenderName").value.trim() || "A Friend";
      const recipientName = recipientInput.value.trim() || "Valued Friend";
      const message = document.getElementById("giftMessage").value.trim() || "Enjoy your store credit gift!";

      if (!recipientEmail || !recipientEmail.includes("@")) {
        alert("Please provide a valid recipient email address.");
        return;
      }

      sendGiftCardBtn.disabled = true;
      submitBtnText.textContent = "Processing Gift Card...";
      giftStatusMessage.style.display = "none";

      try {
        const resp = await fetch("/apps/credit/api/storefront/gift-credit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            senderName,
            recipientName,
            recipientEmail,
            amount: currentAmount,
            message,
            skin: currentSkin
          })
        });

        const data = await resp.json();
        if (data.success) {
          giftStatusMessage.className = "gift-status-msg success";
          giftStatusMessage.innerHTML = "🎉 " + data.message;
          giftStatusMessage.style.display = "block";
          submitBtnText.textContent = "✓ Sent Successfully!";
        } else {
          throw new Error(data.error || "Failed to process gift credit.");
        }
      } catch (err) {
        giftStatusMessage.className = "gift-status-msg error";
        giftStatusMessage.textContent = "Error: " + err.message;
        giftStatusMessage.style.display = "block";
        sendGiftCardBtn.disabled = false;
        submitBtnText.textContent = "Try Again";
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Digital Gift Card Credit",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Send Store Credit as a Gift"
    }
  ]
}
{% endschema %}
