{{ 'credit-storefront.css' | asset_url | stylesheet_tag }}

<div id="credit-multiplier-banner" class="credit-multiplier-bar" data-shop="{{ shop.permanent_domain }}">
  <div class="credit-multiplier-content">
    <span class="credit-multiplier-badge">🔥 {{ block.settings.badge_text | default: '2X BONUS CREDIT' }}</span>
    <span class="credit-multiplier-message">
      {{ block.settings.headline | default: 'Double Cashback Weekend: Earn 2X Store Credit on all orders!' }}
    </span>
    <div class="credit-multiplier-timer">
      <span class="credit-timer-label">Ends in:</span>
      <span id="credit-mult-countdown" class="credit-timer-digits">23h 59m 40s</span>
    </div>
  </div>
</div>

<script>
  (function() {
    var countdownEl = document.getElementById("credit-mult-countdown");
    if (!countdownEl) return;

    // Default to midnight tonight
    var now = new Date();
    var end = new Date(now);
    end.setHours(23, 59, 59, 999);

    function update() {
      var current = new Date();
      var diff = end - current;
      if (diff <= 0) {
        countdownEl.textContent = "00h 00m 00s";
        return;
      }
      var hours = Math.floor(diff / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);

      countdownEl.textContent =
        (hours < 10 ? "0" : "") + hours + "h " +
        (minutes < 10 ? "0" : "") + minutes + "m " +
        (seconds < 10 ? "0" : "") + seconds + "s";
    }

    update();
    setInterval(update, 1000);
  })();
</script>

{% schema %}
{
  "name": "Multiplier Flash Banner",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "2X BONUS CREDIT"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Promotion Headline",
      "default": "Double Cashback Weekend: Earn 2X Store Credit on all orders!"
    }
  ]
}
{% endschema %}
