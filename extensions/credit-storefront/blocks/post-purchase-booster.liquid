{% comment %}
  Post-Purchase Store Credit Booster
  Captures high-intent momentum on Thank You / Order Status page by letting buyers spend newly earned cashback.
{% endcomment %}

<div class="post-purchase-booster-card" id="postPurchaseBooster">
  <div class="booster-badge-row">
    <span class="booster-pulse-dot"></span>
    <span class="booster-badge-text">EXCLUSIVE POST-PURCHASE OFFER</span>
    <div class="booster-timer" id="boosterTimer">
      <span>Expires in:</span>
      <strong id="timerDisplay">14:59</strong>
    </div>
  </div>

  <div class="booster-main-content">
    <div class="booster-reward-banner">
      <div class="booster-icon">🎁</div>
      <div>
        <div class="booster-reward-title">You just earned <span class="booster-cashback-amount">$12.50</span> in Store Credit!</div>
        <div class="booster-reward-sub">Apply your credit right now to add this complement to your order before it ships:</div>
      </div>
    </div>

    <div class="booster-product-card">
      <div class="booster-product-img-box">
        <div class="booster-placeholder-img">🛍️</div>
      </div>

      <div class="booster-product-details">
        <h4 class="booster-product-title">VIP Complete Care & Protection Pack</h4>
        <p class="booster-product-desc">Extend coverage and receive complementary accessories for your purchase.</p>

        <div class="booster-pricing-row">
          <div class="booster-prices">
            <span class="booster-original-price">$28.00</span>
            <span class="booster-deal-price">$15.50</span>
            <span class="booster-credit-applied">($3.00 with your credit)</span>
          </div>
          <span class="booster-savings-tag">SAVE 45%</span>
        </div>

        <div class="booster-actions">
          <button type="button" class="booster-claim-btn" id="claimBoosterBtn">
            <span>⚡ Claim & Pay with Credit</span>
            <span class="btn-subtext">1-Click Fast Checkout</span>
          </button>
          <button type="button" class="booster-skip-btn" id="skipBoosterBtn">
            No thanks, I'll save my credit for later
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .post-purchase-booster-card {
    max-width: 720px;
    margin: 24px auto;
    background: #ffffff;
    border-radius: 16px;
    border: 2px solid #10b981;
    box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0f172a;
  }

  .booster-badge-row {
    background: linear-gradient(135deg, #064e3b 0%, #047857 100%);
    color: #ffffff;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .booster-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.7);
    animation: boosterPulse 1.5s infinite;
    display: inline-block;
    margin-right: 6px;
  }

  @keyframes boosterPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(74, 222, 128, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  .booster-timer {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.25);
    padding: 3px 10px;
    border-radius: 9999px;
    font-family: monospace;
    font-size: 12px;
  }

  .booster-main-content {
    padding: 24px;
  }

  .booster-reward-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 20px;
  }

  .booster-icon {
    font-size: 28px;
  }

  .booster-reward-title {
    font-size: 15px;
    font-weight: 800;
    color: #166534;
  }

  .booster-cashback-amount {
    color: #15803d;
    background: #dcfce7;
    padding: 2px 8px;
    border-radius: 6px;
  }

  .booster-reward-sub {
    font-size: 12px;
    color: #475569;
    margin-top: 2px;
  }

  .booster-product-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    align-items: center;
  }

  @media (max-width: 600px) {
    .booster-product-card {
      grid-template-columns: 1fr;
    }
  }

  .booster-product-img-box {
    width: 140px;
    height: 140px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .booster-placeholder-img {
    font-size: 54px;
  }

  .booster-product-title {
    margin: 0 0 4px 0;
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
  }

  .booster-product-desc {
    margin: 0 0 12px 0;
    font-size: 13px;
    color: #64748b;
  }

  .booster-pricing-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .booster-original-price {
    font-size: 14px;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .booster-deal-price {
    font-size: 20px;
    font-weight: 900;
    color: #0f172a;
  }

  .booster-credit-applied {
    font-size: 13px;
    font-weight: 700;
    color: #15803d;
  }

  .booster-savings-tag {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .booster-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .booster-claim-btn {
    width: 100%;
    padding: 12px 18px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .booster-claim-btn:hover {
    background: #047857;
    transform: translateY(-1px);
  }

  .btn-subtext {
    font-size: 10px;
    font-weight: 500;
    opacity: 0.9;
    margin-top: 2px;
  }

  .booster-skip-btn {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 11px;
    cursor: pointer;
    padding: 4px;
    text-decoration: underline;
  }
  .booster-skip-btn:hover {
    color: #64748b;
  }
</style>

<script>
  (function() {
    let timeLeft = 14 * 60 + 59; // 15 mins
    const timerDisplay = document.getElementById("timerDisplay");
    const boosterCard = document.getElementById("postPurchaseBooster");
    const claimBtn = document.getElementById("claimBoosterBtn");
    const skipBtn = document.getElementById("skipBoosterBtn");

    const timerInterval = setInterval(() => {
      timeLeft--;
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        if (boosterCard) boosterCard.style.display = "none";
        return;
      }
      const mins = Math.floor(timeLeft / 60);
      const secs = timeLeft % 60;
      if (timerDisplay) {
        timerDisplay.textContent = (mins < 10 ? "0" : "") + mins + ":" + (secs < 10 ? "0" : "") + secs;
      }
    }, 1000);

    if (claimBtn) {
      claimBtn.addEventListener("click", () => {
        claimBtn.disabled = true;
        claimBtn.textContent = "Applying credit & redirecting...";
        setTimeout(() => {
          location.href = "/checkout";
        }, 600);
      });
    }

    if (skipBtn) {
      skipBtn.addEventListener("click", () => {
        if (boosterCard) boosterCard.style.display = "none";
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Post-Purchase Booster",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Offer Title",
      "default": "Exclusive Post-Purchase Offer"
    },
    {
      "type": "number",
      "id": "timer_minutes",
      "label": "Timer Duration (minutes)",
      "default": 15
    }
  ]
}
{% endschema %}
