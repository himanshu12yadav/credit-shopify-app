{% comment %}
  Save-the-Sale Return Incentive Block
  Incentivizes shoppers to take store credit with bonus funds rather than cash refunds.
{% endcomment %}

<div class="return-incentive-container" id="returnIncentive">
  <div class="return-incentive-header">
    <span class="incentive-pill">SAVINGS PERK</span>
    <h3 class="incentive-title">Making a Return? Choose Instant Store Credit & Get +20% Bonus!</h3>
    <p class="incentive-sub">Keep your shopping momentum going. Receive an instant extra 20% on top of your refund value with zero bank waiting periods.</p>
  </div>

  <div class="return-options-grid">
    <!-- Option 1: Standard Cash Refund -->
    <div class="return-option-card standard-card">
      <div class="option-tag">Standard Method</div>
      <h4 class="option-name">Refund to Original Payment</h4>
      <div class="option-amount">$50.00</div>
      <ul class="option-perks">
        <li>❌ 5 to 10 business days bank processing</li>
        <li>❌ No bonus spending funds</li>
        <li>❌ Loss of VIP reward progress</li>
      </ul>
      <button type="button" class="option-btn secondary-btn" onclick="alert('Standard return initiated. Processing takes 5-10 business days.');">
        Select Cash Refund ($50.00)
      </button>
    </div>

    <!-- Option 2: Store Credit + 20% Bonus -->
    <div class="return-option-card bonus-card">
      <div class="option-tag recommended-tag">RECOMMENDED (+20% BONUS)</div>
      <h4 class="option-name">Instant Store Credit</h4>
      <div class="option-amount bonus-amount">$60.00</div>
      <ul class="option-perks">
        <li>✨ <strong>+$10.00 Extra Bonus Credit</strong> instantly</li>
        <li>⚡ <strong>Zero wait time</strong> — available immediately for next checkout</li>
        <li>⭐ <strong>Maintains your VIP Tier</strong> status & points</li>
      </ul>
      <button type="button" class="option-btn primary-bonus-btn" onclick="alert('🎉 Congratulations! $60.00 store credit has been credited to your account.');">
        ⚡ Claim $60.00 Store Credit (+20% Bonus)
      </button>
    </div>
  </div>
</div>

<style>
  .return-incentive-container {
    max-width: 780px;
    margin: 28px auto;
    padding: 24px;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0f172a;
  }

  .return-incentive-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .incentive-pill {
    display: inline-block;
    background: #dcfce7;
    color: #15803d;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .incentive-title {
    margin: 0 0 6px 0;
    font-size: 19px;
    font-weight: 800;
  }

  .incentive-sub {
    margin: 0;
    font-size: 13px;
    color: #64748b;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.4;
  }

  .return-options-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 18px;
    align-items: stretch;
  }

  @media (max-width: 650px) {
    .return-options-grid {
      grid-template-columns: 1fr;
    }
  }

  .return-option-card {
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .standard-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }

  .bonus-card {
    background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
    border: 2px solid #10b981;
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.15);
    position: relative;
  }

  .option-tag {
    font-size: 10px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .recommended-tag {
    color: #15803d;
  }

  .option-name {
    margin: 0 0 8px 0;
    font-size: 16px;
    font-weight: 800;
  }

  .option-amount {
    font-size: 28px;
    font-weight: 900;
    color: #334155;
    margin-bottom: 14px;
  }

  .bonus-amount {
    color: #15803d;
  }

  .option-perks {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    font-size: 12px;
    line-height: 1.7;
    color: #475569;
  }

  .option-btn {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .secondary-btn {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #475569;
  }
  .secondary-btn:hover {
    background: #f1f5f9;
  }

  .primary-bonus-btn {
    background: #047857;
    border: none;
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(4, 120, 87, 0.3);
  }
  .primary-bonus-btn:hover {
    background: #065f46;
  }
</style>

{% schema %}
{
  "name": "Return Credit Bonus",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Store Credit & Get +20% Extra"
    }
  ]
}
{% endschema %}
