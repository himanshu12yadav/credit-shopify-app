{{ 'credit-storefront.css' | asset_url | stylesheet_tag }}

{% assign customer_tier = customer.metafields.credit_app.vip_tier.value | default: 'Bronze VIP' %}
{% assign customer_spend = customer.metafields.credit_app.total_spent.value | default: 0 | times: 1.0 %}
{% assign required_tier = block.settings.required_tier | default: 'Gold VIP' %}
{% assign required_spend = 500.0 %}

{% if required_tier == 'Platinum VIP' %}
  {% assign required_spend = 1000.0 %}
{% elsif required_tier == 'Gold VIP' %}
  {% assign required_spend = 500.0 %}
{% elsif required_tier == 'Silver VIP' %}
  {% assign required_spend = 200.0 %}
{% endif %}

{% assign is_unlocked = false %}
{% if customer_spend >= required_spend %}
  {% assign is_unlocked = true %}
{% endif %}

{% assign spend_remaining = required_spend | minus: customer_spend %}
{% if spend_remaining < 0 %}
  {% assign spend_remaining = 0 %}
{% endif %}

<div id="credit-vip-exclusive-lock" class="credit-vip-lock-card {% unless is_unlocked %}is-locked{% endunless %}">
  {% if is_unlocked %}
    <div class="credit-vip-unlocked-banner">
      <span class="credit-vip-unlocked-icon">👑</span>
      <div>
        <h4 class="credit-vip-unlocked-title">{{ block.settings.unlocked_title | default: 'VIP Exclusive Drop Unlocked' }}</h4>
        <p class="credit-vip-unlocked-desc">
          As a valued <strong>{{ customer_tier }}</strong>, you have unlocked exclusive purchasing rights for this limited collection.
        </p>
      </div>
    </div>
  {% else %}
    <div class="credit-vip-locked-banner">
      <div class="credit-vip-lock-header">
        <span class="credit-vip-lock-icon">🔒</span>
        <div>
          <h4 class="credit-vip-locked-title">{{ block.settings.locked_title | default: 'Exclusive to VIP Members' }}</h4>
          <p class="credit-vip-locked-desc">
            This limited release is reserved exclusively for <strong>{{ required_tier }}</strong> members and above.
          </p>
        </div>
      </div>

      <div class="credit-vip-lock-progress-wrap">
        <div class="credit-vip-lock-labels">
          <span>Your Total Spend: ${{ customer_spend | round: 2 }}</span>
          <span>Unlock at: ${{ required_spend | round: 0 }}</span>
        </div>
        <div class="credit-vip-lock-bar">
          {% assign pct = customer_spend | times: 100.0 | divided_by: required_spend %}
          {% if pct > 100 %}{% assign pct = 100 %}{% endif %}
          <div class="credit-vip-lock-fill" style="width: {{ pct }}%;"></div>
        </div>
        <p class="credit-vip-lock-hint">
          Spend <strong>${{ spend_remaining | round: 2 }}</strong> more to immediately unlock this exclusive product!
        </p>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "VIP Product Lock",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "required_tier",
      "label": "Required VIP Tier to Buy",
      "default": "Gold VIP",
      "options": [
        { "value": "Silver VIP", "label": "Silver VIP ($200 Spend)" },
        { "value": "Gold VIP", "label": "Gold VIP ($500 Spend)" },
        { "value": "Platinum VIP", "label": "Platinum VIP ($1000 Spend)" }
      ]
    },
    {
      "type": "text",
      "id": "unlocked_title",
      "label": "Unlocked Banner Title",
      "default": "VIP Exclusive Drop Unlocked"
    },
    {
      "type": "text",
      "id": "locked_title",
      "label": "Locked Banner Title",
      "default": "Exclusive to VIP Members"
    }
  ]
}
{% endschema %}
